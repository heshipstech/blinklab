{
  "name": "blinklab",
  "private": true,
  "version": "0.0.1",
  "license": "MIT",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "bundle:budget": "node tools/checkBundleBudget.mjs",
    "results:write": "node tools/writeResultsBlock.mjs",
    "e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare-assets": "rm -rf public/mediapipe-wasm && cp -R node_modules/@mediapipe/tasks-vision/wasm public/mediapipe-wasm",
    "predev": "npm run prepare-assets",
    "prebuild": "npm run prepare-assets"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "<6.1.0",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@mediapipe/tasks-vision": "^1.0.1"
  }
}
