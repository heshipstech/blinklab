# Dependencies and build output
node_modules/
dist/
coverage/

# Environment and secrets, defensive, the project must never need one
.env
.env.*

# Logs
*.log

# macOS
.DS_Store

# Editors
.vscode/
.idea/

# Python analysis track, from Phase 7
__pycache__/
.venv/
*.egg-info/
.ipynb_checkpoints/

# MediaPipe WASM, copied from the locked npm package at build time
public/mediapipe-wasm/

# Playwright output
test-results/
playwright-report/

# The analysis virtual environment. The lockfile is committed, the
# resolved packages are not.
analysis/.venv/
__pycache__/
.pytest_cache/
.ruff_cache/

# Personal recordings and exports, added in 7.0.
# Video upload mode means clips of real faces now get dragged near this
# folder, and an exported CSV is measurements of somebody's eyes. Both
# are personal data, this repository is public, and git history keeps a
# file even after a later commit deletes it. So they are refused at the
# door rather than cleaned up afterwards.
*.mp4
*.webm
*.mov
*.avi
*.mkv
blinklab-session-*.csv
blinklab-blinks-*.csv
blinklab-frames-*.csv
blinklab-report-*.txt
recordings/

# The development build's fixture recording. It is 478 face-mesh points
# per frame of whoever was in front of the camera, which is landmark
# geometry of a real person's face, and it downloads under a plain name
# with no stamp in it. Roadmap 10.1c, ladder D16: the export guard read
# only backtick calls, so it never asked about this one and nothing
# noticed the rule was missing.
session-*.json

# Except the synthetic test clip, which is generated from a recorded
# command and contains nothing but a test pattern. See
# test/fixtures/README.md.
!test/fixtures/*.mp4

# And except the one committed recording, which is the owner's own and
# is recorded as such in MODEL_CARD's "who it has been tested on".
!test/fixtures/session-*.json

# Throwaway probe scripts written while debugging in a browser.
# They are not part of the project and must not reach a commit.
*.cjs

# Harness scratch. Agent worktrees under .claude/worktrees hold full
# copies of this repository, and on a machine without the local
# excludes a stray `git add .` would commit one whole.
.claude/
